{
  "name": "hireflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "setup:local": "tsx scripts/setup-local.ts",
    "bootstrap": "tsx --env-file=.env.local scripts/bootstrap.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "simulator": "tsx --env-file=.env.local scripts/simulator.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "test:db": "tsx --env-file=.env.local --test tests/supabase.integration.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "perf:seed": "tsx --env-file=.env.local scripts/perf-seed.ts",
    "perf": "tsx --env-file=.env.local scripts/benchmark.ts",
    "retention": "tsx --env-file=.env.local scripts/retention.ts",
    "contract:export": "tsx scripts/export-contract.ts",
    "simulator:mode": "tsx --env-file=.env.local scripts/simulator-mode.ts",
    "outbox:replay": "tsx --env-file=.env.local scripts/replay-event.ts",
    "format": "prettier --write src scripts tests docs package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/postcss": "4.3.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
