{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_code": {
      "type": "string",
      "pattern": "^JOB-[A-Z0-9]{2,12}-[0-9]{3,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 15000
    },
    "required_skills": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "preferred_skills": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "minimum_years": {
      "type": "number",
      "minimum": 0,
      "maximum": 60
    },
    "status": {
      "type": "string",
      "enum": ["draft", "open", "paused", "closed"]
    }
  },
  "required": [
    "job_code",
    "title",
    "description",
    "required_skills",
    "preferred_skills",
    "minimum_years",
    "status"
  ],
  "additionalProperties": false
}
